          "color": "#166b75",
          "items": [
            {
              "id": "L001",
              "startSec": 18.53,
              "endSec": 22.721,
              "text": "Hey, let's go, I can take it"
            },
            {
              "id": "L002",
              "startSec": 22.721,
              "endSec": 25.622,
              "text": "What do you want to know?"
            },
            {
              "id": "L003",
              "startSec": 27.161,
              "endSec": 31.695,
              "text": "得意なことを"
            },
            {
              "id": "L004",
              "startSec": 31.695,
              "endSec": 34.215,
              "text": "自己アピール"
            },
            {
              "id": "L005",
              "startSec": 36.444,
              "endSec": 38.429,
              "text": "I can appear as and when you need",
              "comments": [
                {
                  "role": "human",
                  "text": "修正社区 LRC 缺失词 'I can [?] when you need' -> 'I can appear as and when you need'（与上句『自己アピール』谐音双关）"
                }
              ]
            },
            {
              "id": "L006",
              "startSec": 38.429,
              "endSec": 40.8,
              "text": "365日"
            },
            {
              "id": "L007",
              "startSec": 40.8,
              "endSec": 42.91,
              "text": "I speak different languages"
            },
            {
              "id": "L008",
              "startSec": 42.91,
              "endSec": 45.151,
              "text": "And people get what I mean"
            },
            {
              "id": "L009",
              "startSec": 45.36,
              "endSec": 47.331,
              "text": "中学生の頃は"
            },
            {
              "id": "L010",
              "startSec": 47.331,
              "endSec": 49.698,
              "text": "I was the best in every class"
            },
            {
              "id": "L011",
              "startSec": 49.698,
              "endSec": 50.893,
              "text": "ブラバン部で",
              "comments": [
                {
                  "role": "human",
                  "text": "修正社区 LRC 空耳误听 'プラ板、プーレー' -> 官方日文 'ブラバン部で'（铜管乐队部）；句尾收在 51.026s，与下一句起拍的『楽器』分离"
                }
              ]
            },
            {
              "id": "L012",
              "startSec": 50.893,
              "endSec": 53.557,
              "text": "楽器も吹けるよ (ほら！)",
              "comments": [
                {
                  "role": "human",
                  "text": "『楽器』在 Bar 23 第 3 拍 (51.026s) 弱起进入，『も吹けるよ』落到 51.432s"
                }
              ]
            },
            {
              "id": "L013",
              "startSec": 55.168,
              "endSec": 58.317,
              "text": "But sometimes if I think too hard"
            },
            {
              "id": "L014",
              "startSec": 58.317,
              "endSec": 61.997,
              "text": "I forget that I'm a superstar"
            },
            {
              "id": "L015",
              "startSec": 63.031,
              "endSec": 65.26,
              "text": "Try me! Try me!"
            },
            {
              "id": "L016",
              "startSec": 65.329,
              "endSec": 67.57,
              "text": "'Cause I bet I got what you really need"
            },
            {
              "id": "L017",
              "startSec": 67.57,
              "endSec": 71.96,
              "text": "I'm quick to learn and I can work with people in a team"
            },
            {
              "id": "L018",
              "startSec": 71.982,
              "endSec": 74.22,
              "text": "Try me! Try me!"
            },
            {
              "id": "L019",
              "startSec": 74.292,
              "endSec": 76.51,
              "text": "Did you know I can do anything?"
            },
            {
              "id": "L020",
              "startSec": 76.521,
              "endSec": 81.15,
              "text": "Just witness this impressive list of my activities:"
            },
            {
              "id": "L021",
              "startSec": 81.15,
              "endSec": 83.522,
              "text": "Business!"
            },
            {
              "id": "L022",
              "startSec": 83.522,
              "endSec": 85.531,
              "text": "Dancing!"
            },
            {
              "id": "L023",
              "startSec": 85.531,
              "endSec": 90.25,
              "text": "Throwing a party... with you!"
            },
            {
              "id": "L024",
              "startSec": 90.268,
              "endSec": 94.645,
              "text": "聞いてほしいの"
            },
            {
              "id": "L025",
              "startSec": 94.645,
              "endSec": 99.12,
              "text": "私のこと"
            },
            {
              "id": "L026",
              "startSec": 99.126,
              "endSec": 103.68,
              "text": "All you guys are the same, oh"
            },
            {
              "id": "L027",
              "startSec": 103.724,
              "endSec": 108.03,
              "text": "Just so predictable"
            },
            {
              "id": "L028",
              "startSec": 108.1,
              "endSec": 110.457,
              "text": "短所は頑固なところ"
            },
            {
              "id": "L029",
              "startSec": 110.457,
              "endSec": 112.594,
              "text": "I like to stick to my principles"
            },
            {
              "id": "L030",
              "startSec": 112.594,
              "endSec": 114.83,
              "text": "いつも前向きに行こうよ"
            },
            {
              "id": "L031",
              "startSec": 114.834,
              "endSec": 117.063,
              "text": "それがモットー",
              "comments": [
                {
                  "role": "human",
                  "text": "修正社区 LRC 空耳误听 'それが元' -> 官方歌词 'それがモットー'（Motto）"
                }
              ]
            },
            {
              "id": "L032",
              "startSec": 117.063,
              "endSec": 119.27,
              "text": "I'm gonna make it to the top"
            },
            {
              "id": "L033",
              "startSec": 119.304,
              "endSec": 121.55,
              "text": "夢を叶えたいの",
              "comments": [
                {
                  "role": "human",
                  "text": "修正社区 LRC 假名笔误 '夢を叶いたいの' -> 官方歌词 '夢を叶えたいの'"
                }
              ]
            },
            {
              "id": "L034",
              "startSec": 121.556,
              "endSec": 125.841,
              "text": "But when I do I can promise I won't stop (yeah right)"
            },
            {
              "id": "L035",
              "startSec": 125.841,
              "endSec": 127.96,
              "text": "Try me! Try me!"
            },
            {
              "id": "L036",
              "startSec": 127.96,
              "endSec": 130.25,
              "text": "'Cause I bet I got what you really need"
            },
            {
              "id": "L037",
              "startSec": 130.264,
              "endSec": 134.77,
              "text": "I'm quick to learn and I can work with people in a team"
            },
            {
              "id": "L038",
              "startSec": 134.792,
              "endSec": 136.835,
              "text": "Try me! Try me!"
            },
            {
              "id": "L039",
              "startSec": 136.835,
              "endSec": 139.29,
              "text": "Did you know I can do anything?"
            },
            {
              "id": "L040",
              "startSec": 139.32,
              "endSec": 143.987,
              "text": "Just witness this impressive list of my activities"
            },
            {
              "id": "L041",
              "startSec": 143.987,
              "endSec": 146.239,
              "text": "Step by step, 少しずつ"
            },
            {
              "id": "L042",
              "startSec": 146.239,
              "endSec": 148.44,
              "text": "高く高く登る"
            },
            {
              "id": "L043",
              "startSec": 148.44,
              "endSec": 150.78,
              "text": "踊り場に着いたら"
            },
            {
              "id": "L044",
              "startSec": 150.825,
              "endSec": 152.93,
              "text": "休憩タイムで一休み",
              "comments": [
                {
                  "role": "human",
                  "text": "与官方歌词对齐：'休憩タイムで一休み'"
                }
              ]
            },
            {
              "id": "L045",
              "startSec": 152.93,
              "endSec": 155.063,
              "text": "Think about where I'm going to go"
            },
            {
              "id": "L046",
              "startSec": 155.063,
              "endSec": 157.44,
              "text": "階段登れば登るほど"
            },
            {
              "id": "L047",
              "startSec": 157.44,
              "endSec": 159.695,
              "text": "景色がきれいになってゆく"
            },
            {
              "id": "L048",
              "startSec": 159.695,
              "endSec": 162.48,
              "text": "終わりには何が待っている？"
            },
            {
              "id": "L049",
              "startSec": 162.48,
              "endSec": 165.97,
              "text": "But sometimes if I think too hard"
            },
            {
              "id": "L050",
              "startSec": 165.97,
              "endSec": 170.62,
              "text": "I forget that I'm a superstar"
            },
            {
              "id": "L051",
              "startSec": 170.701,
              "endSec": 172.93,
              "text": "Try me! Try me!"
            },
            {
              "id": "L052",
              "startSec": 172.989,
              "endSec": 175.22,
              "text": "'Cause I bet I've got what you really need"
            },
            {
              "id": "L053",
