            {
              "id": "P001",
              "startSec": 0,
              "endSec": 18.239,
              "text": "Intro (前奏合成器与鼓进入)",
              "comments": [
                {
                  "role": "human",
                  "text": "8 小节纯器乐前奏（约 107.0 BPM，第 1 小节第一拍候选于 0.580s），建立轻快电子合成器律动。"
                }
              ]
            },
            {
              "id": "P002",
              "startSec": 18.201,
              "endSec": 54.757,
              "text": "Verse 1 (主歌 A：自我介绍与特长)",
              "color": "#818cf8",
              "comments": [
                {
                  "role": "human",
                  "text": "16 小节主歌（Bar 9–24）：前 8 小节每 2 小节一句英日交替，后 8 小节加密为每 1 小节一句，句尾『ほら！』带停顿。"
                }
              ]
            },
            {
              "id": "P003",
              "startSec": 54.75,
              "endSec": 63.031,
              "text": "Pre-Chorus 1 (导歌 1：Superstar 铺垫)",
              "color": "#c084fc",
              "comments": [
                {
                  "role": "human",
                  "text": "4 小节导歌（Bar 25–28）：伴奏织体收敛，人声旋律拉长，为副歌『Try me!』蓄力。"
                }
              ]
            },
            {
              "id": "P004",
              "startSec": 63.031,
              "endSec": 81.15,
              "text": "Chorus 1 (副歌 1：Try me! 核心 Hook)",
              "color": "#f43f5e",
              "comments": [
                {
                  "role": "human",
                  "text": "8 小节主副歌（Bar 29–36，含弱起 63.031s）：全曲核心 Hook『Try me! Try me!』，高能量紧凑律动。"
                }
              ]
            },
            {
              "id": "P005",
              "startSec": 81.15,
              "endSec": 90.25,
              "text": "Post-Chorus 1 (副歌延伸：活动报菜名)",
              "color": "#fb923c",
              "comments": [
                {
                  "role": "human",
                  "text": "4 小节副歌后段（Bar 37–40）：口白式连续报出三项活动，极具画面卡点潜力。"
                }
              ]
            },
            {
              "id": "P006",
              "startSec": 90.25,
              "endSec": 125.841,
              "text": "Verse 2 (主歌 B：性格原则与座右铭)",
              "color": "#818cf8",
              "comments": [
                {
                  "role": "human",
                  "text": "16 小节第二段主歌（Bar 41–56）：结构与 Verse 1 对称（前 8 小节疏朗、后 8 小节密集），不经导歌直接推入 Chorus 2。"
                }
              ]
            },
            {
              "id": "P007",
              "startSec": 125.841,
              "endSec": 144.03,
              "text": "Chorus 2 (副歌 2：Try me! 第二次爆发)",
              "color": "#f43f5e",
              "comments": [
                {
                  "role": "human",
                  "text": "8 小节第二段副歌（Bar 57–64）：省略 Post-Chorus 报菜名，句尾直接切入 Bridge 上楼梯意象。"
                }
              ]
            },
            {
              "id": "P008",
              "startSec": 144.03,
              "endSec": 162.45,
              "text": "Bridge (桥段：Step by step 拾级而上)",
              "comments": [
                {
                  "role": "human",
                  "text": "8 小节桥段（Bar 65–72）：每小节一句，围绕攀登阶梯、踊り場小憩与眺望风景展开。"
                }
              ]
            },
            {
              "id": "P009",
              "startSec": 162.45,
              "endSec": 170.661,
              "text": "Pre-Chorus 2 (导歌 2：终局前蓄力)",
              "color": "#c084fc",
              "comments": [
                {
                  "role": "human",
                  "text": "4 小节导歌再现（Bar 73–76）：承接桥段尾句悬念，重新回到 Superstar 主题并引爆双副歌。"
                }
              ]
            },
            {
              "id": "P010",
              "startSec": 170.661,
              "endSec": 188.61,
              "text": "Chorus 3 (副歌 3：终局双副歌前半)",
              "color": "#f43f5e",
              "comments": [
                {
                  "role": "human",
                  "text": "8 小节副歌（Bar 77–84）：双副歌前半段，维持满编能量。"
                }
              ]
            },
            {
              "id": "P011",
              "startSec": 188.61,
              "endSec": 206.634,
              "text": "Chorus 4 (副歌 4：Fine society 终局变奏)",
              "color": "#e11d48",
              "comments": [
                {
                  "role": "human",
                  "text": "8 小节终局副歌（Bar 85–92）：最后一句歌词变为『I'm seeking a position in a fine society』。"
                }
              ]
            },
            {
              "id": "P012",
              "startSec": 206.634,
              "endSec": 209.719,
              "text": "Outro (尾奏定格：Try me!)",
              "comments": [
                {
                  "role": "human",
                  "text": "收尾定格呼喊『Try me!』（206.634s–207.830s）及尾音自然衰减至 209.719s。"
                }
              ]
            }
          ]
