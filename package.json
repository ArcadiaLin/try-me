{
  "name": "try-me",
  "version": "1.0.0",
  "description": "Kero Kero Bonito - Try Me MV Monorepo",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "wavesurfer.js": "^8.0.5"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "npm --workspace @try-me/mv run dev",
    "build": "npm --workspace @try-me/mv run build",
    "upgrade": "remotion upgrade",
    "lint": "eslint apps packages tools && npm --workspace @try-me/mv run typecheck",
    "check:repo": "node tools/repo-guard/check-repo.mjs",
    "analyze:audio": "uv run python tools/audio-analyzer/analyze-audio.py",
    "annotate": "npm --workspace @try-me/annotator run start",
    "test:annotations": "npm --workspace @try-me/annotator run test"
  },
  "allowScripts": {
    "esbuild": false
  }
}
