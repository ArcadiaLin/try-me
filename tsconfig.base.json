{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["es2015"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "paths": {
      "@try-me/shared": ["./packages/shared/src/index.d.ts"],
      "@try-me/shared/*": ["./packages/shared/src/*"]
    }
  },
  "exclude": ["apps/mv/remotion.config.ts"]
}
