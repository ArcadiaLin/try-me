    {
      "id": "guide-v3-15",
      "type": "text",
      "x": 2732,
      "y": -315,
      "width": 486.7199999999999,
      "height": 151.2,
      "angle": 0,
      "strokeColor": "#263238",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.3,
      "strokeStyle": "solid",
