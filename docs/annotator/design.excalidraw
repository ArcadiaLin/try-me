    {
      "id": "guide-v3-82",
      "type": "text",
      "x": 1962,
      "y": 1725,
      "width": 526.3199999999999,
      "height": 277.2,
      "angle": 0,
      "strokeColor": "#263238",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.3,
      "strokeStyle": "solid",
      "roughness": 0,
