    {
      "id": "guide-v3-23",
      "type": "text",
      "x": 1172,
      "y": 395,
      "width": 571.68,
      "height": 151.2,
      "angle": 0,
      "strokeColor": "#263238",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.3,
      "strokeStyle": "solid",
