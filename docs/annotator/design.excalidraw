    {
      "id": "guide-v3-524",
      "type": "text",
      "x": 2782,
      "y": 445,
      "width": 462.24,
      "height": 100.8,
      "angle": 0,
      "strokeColor": "#263238",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.3,
      "strokeStyle": "solid",
      "roughness": 0,
